{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EduTask API task response",
  "description": "Server response; partial drafts may contain empty fields. AI generation uses separate text-only schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "context",
    "users",
    "subject",
    "format",
    "materials",
    "constraints",
    "expectedResult",
    "successCriteria",
    "deadline",
    "contact",
    "interactionFormat",
    "confirmed",
    "score",
    "level",
    "status",
    "breakdown",
    "missingInformation",
    "proposals",
    "result",
    "criteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "materials": {
      "type": "string"
    },
    "expectedResult": {
      "type": "string"
    },
    "deadline": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "interactionFormat": {
      "type": "string"
    },
    "rawDescription": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "criteria": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string"
    },
    "users": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "successCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer"],
            "properties": { "question": { "type": "string" }, "answer": { "type": "string" } }
          }
        ]
      }
    },
    "missingInformation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "level": {
      "enum": [
        "draft",
        "working",
        "ready",
        "priority"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "in_review",
        "selected",
        "completed"
      ]
    },
    "confirmed": {
      "type": "boolean"
    },
    "demo": {
      "type": "boolean"
    },
    "created": {
      "type": "number"
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "teamName",
          "idea",
          "plan",
          "deadline",
          "link",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "teamName": {
            "type": "string"
          },
          "idea": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          }
        }
      }
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "points",
          "maxPoints",
          "passed"
        ],
        "properties": {
          "points": {
            "type": "integer"
          },
          "maxPoints": {
            "type": "integer"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
